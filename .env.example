# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# VITE_ALLTICK_TOKEN: Required for real-time AllTick WebSocket & REST market data.
# Create a .env file in the root directory and add: VITE_ALLTICK_TOKEN=your_token_here
VITE_ALLTICK_TOKEN="your_alltick_token_here"

# VITE_USE_MOCK_DATA: Set to true to enable mock data fallback (default false for production).
VITE_USE_MOCK_DATA="false"

# Supabase Persistence Configuration
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key-here"
