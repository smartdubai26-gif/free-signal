# ============================================================
# AlphaFX — Environment Variables
# ============================================================
# ⚠️  IMPORTANT
#   • Never commit a real .env file. Only this example belongs in git.
#   • Variables prefixed with VITE_ are INLINED INTO THE PUBLIC JS BUNDLE.
#     Never put a secret behind a VITE_ prefix.
#   • All provider secrets below are SERVER-ONLY (no VITE_ prefix).
# ============================================================

# ---------- Server-only secrets (Vercel → Settings → Environment Variables) ----------

# AllTick — real-time market data (REST + WebSocket)
ALLTICK_TOKEN=""

# Twelve Data — historical candles / time series
TWELVE_DATA_API_KEY=""

# Finnhub — quotes and market news
FINNHUB_API_KEY=""

# Supabase — used by server-side scripts and GitHub Actions
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_KEY=""

# ---------- Public client configuration (safe to expose) ----------

# Supabase anon key is designed to be public — it is protected by RLS.
# It is only safe if Row Level Security is ENABLED on every table.
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY=""

# Set to true to run the UI against mock data instead of live feeds.
VITE_USE_MOCK_DATA="false"

# ---------- CORS ----------
# Comma-separated list of origins allowed to call /api/market/*
ALLOWED_ORIGINS="https://free-signal-ten.vercel.app"

# ---------- App ----------
APP_URL="https://free-signal-ten.vercel.app"
